load("@prysm//tools/go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "address.go",
        "encoding.go",
        "hash.go",
        "keygen.go",
        "ots.go",
        "params.go",
        "serialization.go",
        "sign.go",
        "tree.go",
        "verify.go",
    ],
    importpath = "github.com/OffchainLabs/prysm/v7/crypto/xmss",
    visibility = ["//visibility:public"],
    deps = ["@org_golang_x_crypto//sha3:go_default_library"],
)

go_test(
    name = "go_default_test",
    size = "medium",
    srcs = [
        "helpers_test.go",
        "known_answer_test.go",
        "known_answer_vectors_test.go",
        "lean_vectors_test.go",
        "vectors_test.go",
        "xmss_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":go_default_library"],
)
